# ---- Required for runtime AI features (sponsor requirement) ----
# OpenAI powers the Evidence Extractor, Entity Reconciler and Path Explainer.
# Without a key the app runs on the seeded demo fixture and AI endpoints return "not configured".
OPENAI_API_KEY=
# Model used for all three OpenAI roles. Confirm the current model name on platform.openai.com.
OPENAI_MODEL=gpt-5-mini

# ---- Data mode ----
# "fixture" = seeded demo bundle only (Gate 1). "live" = real providers (Gate 2+).
DATA_MODE=fixture

# ---- Optional public-API keys (Gate 2+) ----
# NCBI E-utilities (PubMed/PMC/ClinVar). Works without a key at 3 req/s; key raises to 10 req/s.
NCBI_API_KEY=
NCBI_EMAIL=
# Bright Data (OPTIONAL — only for org/researcher pages without clean APIs)
BRIGHTDATA_API_KEY=
