# ---- Required for runtime AI features (sponsor requirement) ----
# OpenAI powers the Evidence Extractor, Entity Reconciler and Path Explainer.
# Without a key the app still runs; AI endpoints return "not configured".
OPENAI_API_KEY=
# Model used for all three OpenAI roles. .env.local takes precedence over machine-level env vars.
OPENAI_MODEL=gpt-5-mini

# ---- Data bundle ----
# "real" (default) = verified CDD dataset in data/real/cdd-real.json. "fixture" = Gate 1 demo fixture.
DATA_BUNDLE=real

# ---- Optional public-API keys (Gate 2+) ----
# NCBI E-utilities (PubMed/PMC/ClinVar). Works without a key at 3 req/s; key raises to 10 req/s.
NCBI_API_KEY=
NCBI_EMAIL=
# Bright Data (OPTIONAL — only for org/researcher pages without clean APIs)
BRIGHTDATA_API_KEY=
